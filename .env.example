# Copy to .env.production (or set in your host's env settings) before `npm run build`.

# Public URL printed on share cards and captions. Leave empty to use the page's own origin.
# (config.json "shareUrl" takes precedence over this if set.)
VITE_SHARE_URL=https://your-domain.example

# Analytics collector for run_start / ending_reached / share_clicked / ad_clicked.
# Empty = events are only logged to the console in dev.
VITE_ANALYTICS_URL=
